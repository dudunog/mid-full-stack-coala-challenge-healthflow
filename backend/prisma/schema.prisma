generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATTENDANT
  DOCTOR
}

enum ExamStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
  REPORTED
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String
  password  String
  role      Role
  exams     MedicalExam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalExam {
  id               String     @id @default(cuid())
  status           ExamStatus @default(PENDING)
  processingResult String?
  report           String?
  attendantId      String
  attendant        User       @relation(fields: [attendantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
